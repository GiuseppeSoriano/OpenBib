# =========================================================
# Project ignore rules
# =========================================================

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# ── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── Environment & secrets ─────────────────────────────────
.env
.env.local
.env.production

# ── IDE / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# ── Data & caches ─────────────────────────────────────────
data/
*.sqlite3
.conda/
.conda-pkgs/
.vendor/

# ── Docker ────────────────────────────────────────────────
docker-compose.override.yml

# Release tooling, test reports and private backups
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.dump
*.sql
*.pem
*.key

# Local generated artifacts.
artifacts/
