# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://openbib:openbib@localhost:5432/openbib
ENVIRONMENT=development
# Local development does not create backups or use an off-site deletion journal.
BACKUPS_ENABLED=false
DELETION_JOURNAL_ENABLED=false
APP_PUBLIC_URL=http://localhost:3000

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Versioned 32-byte base64 keyring. Replace this value even for long-lived local data.
APP_ENCRYPTION_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
APP_ACTIVE_KEY_VERSION=1
RATE_LIMIT_HMAC_KEY=development-rate-limit-key

# Local Docker uses Mailpit at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=OpenBib <noreply@localhost>

# Required for paper search, details and citation graphs. Never commit the real key.
SEMANTIC_SCHOLAR_API_KEY=
# Optional Docker secret file (takes precedence over the environment value).
SEMANTIC_SCHOLAR_API_KEY_FILE=

# ── DOI resolution ─────────────────────────────────────────
# Seconds to resolve one DOI before it is saved as pending.
DOI_RESOLVE_TIMEOUT_SECONDS=15
# Parallel doi.org checks for DOIs the provider does not know, and the overall
# time budget per import request (lookups are batched, 500 DOIs per call).
IMPORT_RESOLVE_CONCURRENCY=4
IMPORT_REQUEST_BUDGET_SECONDS=25

# ── Graph related papers ──────────────────────────────────
# Papers per range, Semantic Scholar page size (100-1000) and the depth cap in
# raw provider records (1000-10000; totals above it read "first 10,000 of N").
GRAPH_RELATED_RANGE_SIZE=30
GRAPH_RELATED_CHUNK_SIZE=1000
GRAPH_RELATED_MAX_RESULTS=10000
# Provider pages fetched per request while a list is collected and ranked.
GRAPH_RELATED_PAGES_PER_REQUEST=4
# Seconds one request may spend scanning the list; parallel sources per top-up.
GRAPH_RELATED_SCAN_BUDGET_SECONDS=20
GRAPH_RELATED_TOPUP_CONCURRENCY=1

# Inactive providers below are retained for future versions.
# ── OpenAlex ───────────────────────────────────────────────
OPENALEX_API_KEY=
OPENALEX_EMAIL=your-email@example.com

# ── Crossref ───────────────────────────────────────────────
CROSSREF_MAILTO=your-email@example.com

# ── Cache TTLs (seconds) ──────────────────────────────────
CACHE_TTL_LOOKUP=86400
CACHE_TTL_SEARCH=3600
CACHE_TTL_REFERENCES=86400
CACHE_TTL_CITATIONS=86400
CACHE_TTL_AUTHOR=43200

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Rate limits are enforced server-side.
