# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://refman:refman@localhost:5432/refman

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080

# ── OpenAlex ───────────────────────────────────────────────
OPENALEX_API_KEY=
OPENALEX_EMAIL=your-email@example.com

# ── Crossref ───────────────────────────────────────────────
CROSSREF_MAILTO=your-email@example.com

# ── Cache TTLs (seconds) ──────────────────────────────────
CACHE_TTL_LOOKUP=86400
CACHE_TTL_SEARCH=3600
CACHE_TTL_REFERENCES=86400
CACHE_TTL_CITATIONS=86400
CACHE_TTL_AUTHOR=43200

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate limits (req/min) ─────────────────────────────────
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_AUTH=20
